JWT_SECRET="super-secret-jwt-key-change-me"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# WEB
VITE_API_URL="http://localhost:3000/api/v1"

# ─── EMAIL (SMTP) — requis pour l'envoi des emails ───
# Valeurs par défaut alignées sur le serveur mail de l'entreprise (projet Audit).
# Hôte par défaut : 192.168.0.247:587 (tls rejectUnauthorized=false)
SMTP_HOST="192.168.0.247"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=support@groupesorepco.com
SMTP_PASS=dirSRPC2854
SMTP_FROM="SOREPCO MARKETING <support@groupesorepco.com>"

# ─── RAPPORT HEBDOMADAIRE DES VENTES (cron) ───
# Destinataires (séparés par des virgules)
# Créneau cron (défaut : mardi 11:00)
WEEKLY_REPORT_CRON="0 11 * * 2"

# ─── ACTIVATION AUTOMATIQUE DES CAMPAGNES (PLANIFIEE → ACTIVE) ───
# Fréquence du cron (défaut : tous les jours à 00:05)
CAMPAIGN_AUTO_ACTIVATE_CRON="5 0 * * *"
