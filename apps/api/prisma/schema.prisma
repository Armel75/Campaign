// This is the Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver" // Changed to sqlite for preview environment compatibility. Change to "sqlserver" for production.
  url = env("DATABASE_URL")
}

model User {
  id                      Int    @id @default(autoincrement())
  username                String    @unique
  email                   String    @unique
  passwordHash            String    @map("password_hash")
  roleId                  Int    @map("role_id")
  role                    Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  refreshSessions         RefreshSession[]
  // Relations
  createdCampaigns        Campaign[]
  tasks                   Task[]
  createdBudgetPlans      BudgetPlan[]
  createdBudgetLines      BudgetLine[]
  createdObjectives       Objective[]
  createdTargetAudiences  TargetAudience[]
  createdChannels         Channel[]
  createdCampaignMetrics  CampaignMetric[]
  createdLeads            Lead[]
  createdConversions      Conversion[]
  createdTasks            Task[] @relation("TaskCreatedBy")
  createdExpenses         Expense[]
  createdAttachments      Attachment[]
  createdCampaignKpiTargets CampaignKpiTarget[]
  createdArticles         Article[]

  @@map("users")
}

model Role {
  id        Int   @id @default(autoincrement())
  name      String   @unique

  // Campaign permissions
  canViewAllCampaigns      Boolean @default(false) @map("can_view_all_campaigns")
  canEditAllCampaigns      Boolean @default(false) @map("can_edit_all_campaigns")
  canDeleteAllCampaigns    Boolean @default(false) @map("can_delete_all_campaigns")
  canCreateCampaign        Boolean @default(false) @map("can_create_campaign")

  // Tasks
  canManageTasks            Boolean @default(false) @map("can_manage_tasks")
  canAssignTasks            Boolean @default(false) @map("can_assign_tasks")

  // Campaign content
  canManageCampaignArticles Boolean @default(false) @map("can_manage_campaign_articles")
  canManageAttachments      Boolean @default(false) @map("can_manage_attachments")

  // Administration
  canManageUsers            Boolean @default(false) @map("can_manage_users")
  canManageRoles            Boolean @default(false) @map("can_manage_roles")
  canExportCampaign         Boolean @default(false) @map("can_export_campaign")
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model BudgetPlan {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  status      String      @default("DRAFT") // DRAFT | APPROVED | ARCHIVED (exemple)
  currency    String      @default("XAF")
  createdById Int         @map("created_by")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  budgetLines BudgetLine[]
  campaigns   Campaign[]

  @@map("budget_plans")
}

model BudgetLine {
  id            Int       @id @default(autoincrement())
  budgetPlanId  Int       @map("budget_plan_id")
  createdById   Int       @map("created_by")

  label         String
  plannedAmount Decimal   @db.Decimal(18, 2) @map("planned_amount")

  notes         String?
  order         Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  budgetPlan    BudgetPlan @relation(fields: [budgetPlanId], references: [id], onDelete: Cascade)
  createdBy     User       @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expenses      Expense[]  // ✅ 1 BudgetLine -> N Expense

  @@index([budgetPlanId])
  @@map("budget_lines")
}

model Campaign {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  objectiveId   Int       @map("objective_id")
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  status        String
  budgetPlanId  Int?      @map("budget_plan_id")
  createdById   Int       @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  objective       Objective            @relation(fields: [objectiveId], references: [id])
  budgetPlan      BudgetPlan?          @relation(fields: [budgetPlanId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  channels        CampaignChannel[]
  targetAudiences CampaignTargetAudience[]
  metrics         CampaignMetric[]
  leads           Lead[]
  tasks           Task[]
  attachments     Attachment[]
  kpiTargets      CampaignKpiTarget[]
  conversions     Conversion[]
  articles        Article[]

  @@index([budgetPlanId])
  @@map("campaigns")
}

model Objective {
  id          Int     @id @default(autoincrement())
  code        String     @unique
  label       String
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  createdById Int        @map("created_by")
  campaigns   Campaign[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("objectives")
}

model TargetAudience {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaigns   CampaignTargetAudience[]

  @@map("target_audiences")
}

model Channel {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaigns   CampaignChannel[]

  @@map("channels")
}

model CampaignChannel {
  id              Int      @id @default(autoincrement())
  campaignId      Int      @map("campaign_id")
  channelId       Int      @map("channel_id")
  budgetAllocated Decimal  @db.Decimal(32, 16) @map("budget_allocated")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel  Channel  @relation(fields: [channelId], references: [id])

  @@map("campaign_channels")
}

model CampaignMetric {
  id          Int   @id @default(autoincrement())
  campaignId  Int   @map("campaign_id")
  createdById Int   @map("created_by")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metricName  String   @map("metric_name")
  metricValue Decimal  @map("metric_value")
  metricDate  DateTime @default(now()) @map("metric_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("campaign_metrics")
}

model Lead {
  id          Int       @id @default(autoincrement())
  campaignId  Int       @map("campaign_id")
  createdById Int       @map("created_by")
  campaign    Campaign     @relation(fields: [campaignId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  email       String
  phone       String?
  status      String       // NEW, CONTACTED, QUALIFIED, CONVERTED
  conversions Conversion[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("leads")
}

model Conversion {
  id             Int      @id @default(autoincrement())
  campaignId     Int      @map("campaign_id")
  leadId         Int      @map("lead_id")
  createdById    Int      @map("created_by")
  amount         Decimal
  conversionDate DateTime @default(now()) @map("conversion_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("conversions")
}

model Task {
  id          Int   @id @default(autoincrement())
  campaignId  Int   @map("campaign_id")
  createdById Int   @map("created_by")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String
  description String?
  assignedTo  Int?   @map("assigned_to")
  assignee    User?     @relation(fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User      @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dueDate     DateTime @map("due_date")
  status      String   // TODO, IN_PROGRESS, DONE
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}

model Expense {
  id           Int   @id @default(autoincrement())
  budgetLineId Int       @map("budget_line_id")
  createdById  Int       @map("created_by")
  description  String
  amount       Decimal
  expenseDate  DateTime @map("expense_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  createdBy    User       @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([budgetLineId])
  @@map("expenses")
}

model Attachment {
  id          Int      @id @default(autoincrement())
  fileName    String
  filePath    String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  campaignId  Int?     @map("campaign_id")
  createdById Int      @map("created_by")
  uploadedAt  DateTime @default(now()) @map("uploadedAt")

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  createdBy  User      @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("attachments")
}

model CampaignKpiTarget {
  id          Int   @id @default(autoincrement())
  campaignId  Int   @map("campaign_id")
  createdById Int   @map("created_by")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kpiName     String   @map("kpi_name")
  targetValue Decimal  @map("target_value")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("campaign_kpi_targets")
}

model RefreshSession {
  id           Int   @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  userAgent    String?
  ip           String?

  @@index([userId])
  @@index([expiresAt])
}

model CampaignTargetAudience {
  id               Int      @id @default(autoincrement())
  campaignId       Int      @map("campaign_id")
  targetAudienceId Int      @map("target_audience_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetAudience TargetAudience @relation(fields: [targetAudienceId], references: [id], onDelete: Cascade)

  @@map("campaign_target_audiences")
}

model Article {
  id                 Int      @id @default(autoincrement())
  campaignId         Int      @map("campaign_id")
  createdById        Int      @map("created_by")

  codeSageX3         String?  @map("code_sage_x3")
  codeSage100        String?  @map("code_sage_100")
  designation        String

  plannedQuantity    Int?     @map("planned_quantity")
  quantityAtCreation Int?     @map("quantity_at_creation")
  quantityAtStart    Int?     @map("quantity_at_start")
  currentQuantity    Int?     @map("current_quantity")
  quantityAtClosure  Int?     @map("quantity_at_closure")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy          User     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("articles")
}